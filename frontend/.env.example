# Copy to .env.local (git-ignored).

# false = call the real backend (default for deployment).
# true  = offline demo: only the 3 built-in example snippets "verify"; no backend needed.
NEXT_PUBLIC_USE_MOCK=false

# Where Next.js proxies /api/* to (server-side only, read at build/start time).
BACKEND_URL=http://127.0.0.1:8000

# NEVER put API keys here. GEMINI_API_KEY lives in backend/.env only.
