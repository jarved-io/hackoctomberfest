# Copy to backend/.env (never commit .env). Server-side only.

# --- Web ---
# Comma-separated browser origins allowed to call the API directly (the Next.js proxy does not need CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Gemma 4 explanation layer ---
# Set to false to run fully deterministic (no model calls at all).
ENABLE_AI_EXPLANATION=true
# Google AI Studio key (GOOGLE_API_KEY is also accepted). Without a key the API still works and returns
# deterministic explanations with ai.aiStatus = "unavailable".
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Tried automatically on timeout / rate-limit / 5xx. Set to "none" to disable.
GEMMA_FALLBACK_MODEL=gemma-4-31b-it
GEMMA_TIMEOUT_SECONDS=20
GEMMA_MAX_CODE_CHARS=20000
